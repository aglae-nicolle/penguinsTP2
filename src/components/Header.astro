---
const especeSelectionnee = Astro.url.searchParams.get("espece") ?? "";
const especes = ["Adelie", "Chinstrap", "Gentoo"];
---

<header class="p-4 flex items-center gap-2">
    <label for="espece-select" class="font-medium">Filtrer par espèce :</label>
    <select id="espece-select" class="border rounded px-2 py-1">
        <option value="" selected={especeSelectionnee === ""}>Toutes</option>
        {
            especes.map((espece) => (
                <option value={espece} selected={especeSelectionnee === espece}>
                    {espece}
                </option>
            ))
        }
    </select>
</header>

<script>
    const select = document.getElementById(
        "espece-select",
    ) as HTMLSelectElement;
    select.addEventListener("change", () => {
        const url = new URL(window.location.href);
        if (select.value) {
            url.searchParams.set("espece", select.value);
        } else {
            url.searchParams.delete("espece");
        }
        window.location.href = url.toString();
    });
</script>
