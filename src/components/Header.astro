---
const links = [
    { href: "/", label: "Accueil" },
    { href: "/especes/Adelie", label: "Adelie" },
    { href: "/especes/Gentoo", label: "Gentoo" },
    { href: "/especes/Chinstrap", label: "Chinstrap" },
];
const current = Astro.url.pathname.replace(/\/$/, "");
---

<nav class="flex gap-4 p-4 border-b">
    {
        links.map(({ href, label }) => (
            <a
                href={href}
                class:list={[
                    "px-3 py-1 rounded hover:bg-gray-100",
                    current === href && "bg-blue-200 font-bold",
                ]}
            >
                {label}
            </a>
        ))
    }
</nav>
