---
import * as Plot from "@observablehq/plot";
import { JSDOM } from "jsdom";
import penguins from "../assets/penguins.json";

interface Props {
    species: "Adelie" | "Gentoo" | "Chinstrap";
}
const { species } = Astro.props;

const penguinsSpecies = penguins.filter((p) => p.species === species);

const { document } = new JSDOM("").window;

const plot = Plot.plot({
    document,
    width: 640,
    grid: true,
    marks: [
        Plot.dot(penguinsSpecies, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "sex",
            tip: true,
        }),
    ],
});
---

<figure class="p-4">
    <figcaption class="mb-2 text-xl font-semibold">{species}</figcaption>
    <Fragment set:html={plot.outerHTML} />
</figure>
